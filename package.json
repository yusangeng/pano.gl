{
  "name": "pano.gl",
  "version": "1.0.0",
  "description": "Dependency-light WebGPU/WebGL2 viewer for equirectangular 360 images and video",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yusangeng/pano.gl.git"
  },
  "bugs": {
    "url": "https://github.com/yusangeng/pano.gl/issues"
  },
  "keywords": [
    "panorama",
    "equirectangular",
    "video-player",
    "webgl",
    "webgpu"
  ],
  "author": {
    "name": "yusangeng",
    "email": "yusangeng@outlook.com"
  },
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:unit:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration --project no-webgpu",
    "test:coverage": "vitest run --project unit --coverage --coverage.reporter=text --coverage.reporter=json-summary && node scripts/check-coverage.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/integration && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint src test scripts \"demo/**/*.ts\"",
    "gen:shaders": "node scripts/gen-shader-constants.mjs",
    "start": "vite demo",
    "doc": "typedoc --out docs/api src/index.ts"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "gl-matrix": "^3.4.3"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/node": "^22",
    "@vitest/browser": "^5",
    "@vitest/browser-playwright": "^5",
    "@vitest/coverage-v8": "^5",
    "@webgpu/types": "^0.1.74",
    "eslint": "^9",
    "neostandard": "^0.12.0",
    "playwright": "^1.63.0",
    "typedoc": "^0.28",
    "typescript": "^5.9",
    "vite": "^7",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
