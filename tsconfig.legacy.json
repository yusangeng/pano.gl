/*
 * Editor-facing intent record for legacy/, nothing more.
 *
 * tsserver auto-discovery only follows files NAMED tsconfig.json /
 * jsconfig.json up the directory tree, so this file is never picked up on its
 * own -- editors stay quiet on legacy/ because those files match no program's
 * include at all (they fall into the lenient inferred-project default), not because of anything
 * here. It is kept as the written-down intent (and works when passed
 * explicitly, `tsc -p tsconfig.legacy.json`), which is how P1 verified it.
 * Do not credit it with editor integration it does not provide. Deleted by P7
 * along with legacy/ itself. (Final branch review MINOR 5, 2026-09-20.)
 */
{
  "extends": "./tsconfig.json",
  "compilerOptions": { "checkJs": false, "allowJs": true, "declaration": false, "noEmit": true },
  "include": ["legacy/**/*.js"]
}
